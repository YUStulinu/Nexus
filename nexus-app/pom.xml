<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>nexus</groupId>
    <artifactId>nexus-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>nexus-app</artifactId>
  <name>NEXUS app</name>
  <description>The JavaFX desktop application: the node editor, the live views and the dashboards.</description>

  <dependencies>
    <dependency>
      <groupId>nexus</groupId>
      <artifactId>nexus-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>nexus</groupId>
      <artifactId>nexus-engines</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>nexus</groupId>
      <artifactId>nexus-ml</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Copies every runtime dependency to target/lib: with the app jar this is the module path
           the launcher scripts (nexus.cmd / nexus.sh) start the application from. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
